{
    "name": "outsanity/ip-analysis",
    "description": "Library for analyzing IP addresses",
    "type": "library",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Doug Harple",
            "email": "dharple@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1.2",
        "symfony/http-foundation": ">=6.4.29"
    },
    "require-dev": {
        "outsanity/phpcs": "^1.1.1",
        "phpstan/phpstan": "^2.2.2",
        "phpunit/phpunit": "^12.5.29",
        "rector/rector": "^2.4.5",
        "symfony/dotenv": "^6.4.39",
        "symfony/flex": "^2.11.0",
        "symfony/serializer": "^6.4.37"
    },
    "suggest": {
        "symfony/serializer": "Serialization support for SpecialAddressBlock"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/flex": true
        },
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "cooldown": {
                "period": "3 days",
                "ignore": {
                    "outsanity/*": "internal packages"
                }
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Outsanity\\IpAnalysis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Outsanity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcbf":  "phpcbf",
        "phpcs":   "phpcs",
        "phpstan": "phpstan analyse",
        "test":    "phpunit"
    }
}
